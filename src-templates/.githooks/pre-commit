#!/usr/bin/env sh
#
# dxkit pre-commit hook — runs the CHANGED-ONLY tier of ./dxkit-guardrails.sh.
#
# The checks and their order live in ONE place: ./dxkit-guardrails.sh at the
# repo root, the same script the pre-push hook and the CI workflow run. This
# hook asks it for `--changed-only`, the fastest tier: the findings guardrail
# only, blocking only on findings that overlap lines you changed. The pre-push
# hook runs the quick tier and the CI workflow runs everything; run
# `./dxkit-guardrails.sh` with no arguments for the pipeline's full verdict.
#
# Install:
#   git config core.hooksPath .githooks
#
# Escape hatches:
#   DXKIT_SKIP_HOOKS=1 git commit ...     # one-off bypass
#   git commit --no-verify ...            # standard git bypass
#
# First-time setup: this hook does NOT block when no baseline exists
# yet. Run `vyuh-dxkit baseline create` once to capture today's state,
# then commits start being gated against it.

set -e

if [ "${DXKIT_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[dxkit pre-commit] DXKIT_SKIP_HOOKS=1 set — skipping guardrail check."
  exit 0
fi

# Git runs hooks from the root of the working tree, where the script lives.
# A file there without dxkit's header is not dxkit's entry point: refuse it
# rather than let an unrelated script stand in for the checks.
if [ ! -f ./dxkit-guardrails.sh ] || ! grep -q 'dxkit guardrails entry point' ./dxkit-guardrails.sh; then
  echo "[dxkit pre-commit] ./dxkit-guardrails.sh is missing from the repo root, or is not dxkit's, so nothing can be checked." >&2
  echo "  Restore it with: npx vyuh-dxkit update   (then commit it)" >&2
  echo "  Or skip this hook for this commit: DXKIT_SKIP_HOOKS=1 git commit ..." >&2
  exit 1
fi

# `sh` rather than relying on the executable bit, which a checkout can drop.
exec sh ./dxkit-guardrails.sh --changed-only </dev/null
