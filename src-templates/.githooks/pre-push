#!/usr/bin/env sh
#
# dxkit pre-push hook — runs the QUICK tier of ./dxkit-guardrails.sh.
#
# The checks (correctness floor, policy-render parity, findings guardrail)
# and their order live in ONE place: ./dxkit-guardrails.sh at the repo root,
# the same script the CI workflow (dxkit-guardrails.yml) runs and that you or
# an agent can run by hand. This hook adds only what is specific to a push:
# the escape hatch, the delete-only skip, and `--quick`, the cheap tier (the
# floor scoped to the change, the guardrail scanned incrementally, stop at
# the first failure) so the push boundary stays fast. Run
# `./dxkit-guardrails.sh` with no arguments for the pipeline's full verdict.
#
# Install:
#   git config core.hooksPath .githooks
#
# Escape hatches:
#   DXKIT_SKIP_HOOKS=1 git push ...       # one-off bypass
#   git push --no-verify ...              # standard git bypass

set -e

if [ "${DXKIT_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[dxkit pre-push] DXKIT_SKIP_HOOKS=1 set — skipping guardrail check."
  exit 0
fi

# Delete-only pushes (e.g. `git push origin --delete <branch>`) carry
# no commits to gate. Git invokes pre-push with stdin lines of the
# form: <local-ref> <local-sha> <remote-ref> <remote-sha>. A delete
# has local-sha = 40 zeros. Skip rather than failing the gate on an
# empty diff.
all_zero=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "${local_sha}" != "0000000000000000000000000000000000000000" ]; then
    all_zero=false
    break
  fi
done
if [ "${all_zero}" = "true" ]; then
  echo "[dxkit pre-push] Delete-only push detected — skipping guardrail check."
  exit 0
fi

# Git runs hooks from the root of the working tree, where the script lives.
if [ ! -f ./dxkit-guardrails.sh ]; then
  echo "[dxkit pre-push] ./dxkit-guardrails.sh is missing from the repo root, so nothing can be checked." >&2
  echo "  Restore it with: npx vyuh-dxkit update   (then commit it)" >&2
  echo "  Or skip this hook for this push: DXKIT_SKIP_HOOKS=1 git push ..." >&2
  exit 1
fi

# `sh` rather than relying on the executable bit, which a checkout can drop.
exec sh ./dxkit-guardrails.sh --quick </dev/null
